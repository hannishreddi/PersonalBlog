# Copy to .env.local and fill in. Both values are public by design (the
# publishable key only grants what Row Level Security allows the anon role).
# Find them in the Supabase dashboard: Project Settings -> API Keys
# (use the "Publishable key", sb_publishable_..., not the secret key).
#
# Never put a secret / service-role key or database password in a
# NEXT_PUBLIC_* variable or in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# --- Server-only secrets (reader comments and likes) -------------------------
# Never prefix these with NEXT_PUBLIC_. They are read only by server code.
#
# Secret API key (sb_secret_...) from Project Settings -> API Keys. Used only
# to call the engagement database functions (see README "Reader engagement").
SUPABASE_SECRET_KEY=sb_secret_your-key
# At least 32 random characters, used to HMAC visitor ids and IP addresses.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it resets everyone's "liked" state and all rate-limit counters.
ENGAGEMENT_HASH_SECRET=replace-with-at-least-32-random-characters
